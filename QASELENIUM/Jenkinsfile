
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Project Structure') {
            steps {
                bat 'dir'
                bat 'dir QASELENIUM'
            }
        }

        stage('Build Maven Project') {
            steps {
                dir('QASELENIUM') {
                    bat 'mvn clean'
                }
            }
        }

        stage('Execute Selenium Tests') {
            steps {
                dir('QASELENIUM') {
                    bat 'mvn test'
                }
            }
        }
    }

    post {
        always {
            echo 'Build execution completed'
        }
    }
}
